# Auto-detect text files and normalize line endings to LF.
* text=auto

# Explicit LF for source/config files.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Binary for lockfiles (binary-safe, no line ending conversion).
uv.lock binary
*.lock binary
