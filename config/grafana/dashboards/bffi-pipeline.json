    {
      "id": 105,
      "type": "bargauge",
      "title": "${melinda_total} records",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bffi-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(  bffi_stage_entities_processed_total{stage=\"melinda-sync\",phase=\"_\",run_uuid=\"$active_run\"}  / bffi_stage_entities_total{stage=\"melinda-sync\",phase=\"_\",run_uuid=\"$active_run\"}  * 100  + 100 * scalar(count(bffi_stage_ended_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}) or vector(0)),  100)",
          "legendFormat": "% done"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "text": {
          "titleSize": 11,
          "valueSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
