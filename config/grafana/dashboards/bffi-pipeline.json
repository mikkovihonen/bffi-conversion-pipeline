{
  "title": "BFFI pipeline",
  "uid": "bffi-pipeline",
  "tags": [
    "bffi",
    "pipeline"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "2s",
  "time": {
    "from": "now-2h",
    "to": "now"
  },
  "panels": [
    {
      "id": 32,
      "type": "stat",
      "title": "Run ${active_run}",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bffi-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bffi_run_description{run_uuid=\"$active_run\"}",
          "legendFormat": "{{description}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "name",
        "colorMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        },
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Started",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bffi-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(bffi_stage_started_timestamp{run_uuid=\"$active_run\"}) * 1000",
          "legendFormat": "started"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Ended",
      "description": "Wall-clock end of the most recent finished stage. Shows \u2014 while the run is in progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "bffi-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bffi_stage_ended_timestamp{run_uuid=\"$active_run\"}) * 1000",
          "legendFormat": "ended"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014",
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 100,
      "type": "stat",
      "title": "melinda-sync",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bffi-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(40 * count(bffi_stage_failed{stage=\"melinda-sync\",run_uuid=\"$active_run\"})) or on() (sum(30 * (count(bffi_stage_ended_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}) or on() vector(0)) + 20 * ((count(bffi_stage_started_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}) unless count(bffi_stage_ended_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"})) or on() vector(0)) + 10 * (count(bffi_stage_planned{stage=\"melinda-sync\",run_uuid=\"$active_run\"} unless on(stage, run_uuid) bffi_stage_started_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}) or on() vector(0))) or on() vector(0))",
          "legendFormat": "melinda-sync"
        },
        {
          "refId": "B",
          "expr": "label_replace(bffi_stage_eta_seconds{stage=\"melinda-sync\",phase=\"_\",run_uuid=\"$active_run\"} unless on(stage,run_uuid) bffi_stage_ended_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}, \"eta_prefix\", \"ETA\", \"\", \"\") or label_replace(bffi_stage_ended_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"} - bffi_stage_started_timestamp{stage=\"melinda-sync\",run_uuid=\"$active_run\"}, \"eta_prefix\", \" \", \"\", \"\")",
          "legendFormat": "{{eta_prefix}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "vertical",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "skipped",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "skipped",
                  "color": "text"
                },
                "10": {
                  "text": "pending",
                  "color": "orange"
                },
                "20": {
                  "text": "running",
                  "color": "green"
                },
                "30": {
                  "text": "done",
                  "color": "blue"
                },
                "40": {
                  "text": "failed",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": " "
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "mappings",
                "value": []
              },
              {
                "id": "noValue",
                "value": ""
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
