# Every setting below is optional — the defaults in
# `src/bffi_pipeline/config.py` are what the pipeline runs on. Copy this
# file to `.env` only when you need to override one.
#
# All names carry the `BFFI_` prefix and map 1:1 onto a field on the
# `Settings` model in `src/bffi_pipeline/config.py`. Unknown `BFFI_*`
# names are silently ignored (`extra="ignore"`), so a typo here fails
# quietly — check the field list in config.py if an override seems to
# have no effect.

# --- URI namespaces (do not change without surfacing the decision) ----
#
# These are committed identifiers: they appear in every emitted graph and
# in the URNs cataloguers cite. Changing one invalidates every URI minted
# so far. See "Committed identifiers" in CLAUDE.md.
BFFI_WORK_NAMESPACE=http://urn.fi/URN:NBN:fi:bib:work:
BFFI_EXPRESSION_NAMESPACE=http://urn.fi/URN:NBN:fi:bib:expression:
BFFI_MANIFESTATION_NAMESPACE=http://urn.fi/URN:NBN:fi:bib:manifestation:
BFFI_SOURCE_URI=http://urn.fi/URN:NBN:fi:bib:source:local

# --- Paths ------------------------------------------------------------
#
# All default to sub-directories of the repo root. `BFFI_RUNS_DIR` is the
# canonical runs root: `bffi-pipeline new-run` mints
# `<runs-dir>/<yyyymmdd-hhmm-6hex>/` and every stage's `--output-dir` is
# validated against that convention (see `src/bffi_pipeline/runs.py`).
BFFI_RUNS_DIR=./runs
BFFI_DATA_DIR=./data
BFFI_VOCAB_DIR=./vocab
BFFI_CONFIG_DIR=./config
BFFI_SPARQL_DIR=./sparql

# --- Debugging --------------------------------------------------------
#
# rdflib's per-triple "does not look like a valid URI" and bad-literal
# warnings are suppressed by default: real corpus MARCXML routes through
# marc2bibframe2 and produces malformed URI fragments and date literals
# in volume, which the BIBFRAME -> BFFI sanitizers strip before
# serialisation. Set to 1 when onboarding a new source format and you
# need to see what rdflib is choking on.
# BFFI_RDFLIB_VERBOSE=1
